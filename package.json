{
  "name": "uppt",
  "version": "0.0.1",
  "private": true,
  "description": "Composite GitHub Action to release PRs from conventional commits, tag on merge, publish to npm via OIDC.",
  "author": "Daniel Roe <daniel@roe.dev>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run --coverage",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
